{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(images|uploads|foto)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/style\\.css",
      "dest": "/style.css"
    },
    {
      "src": "/([a-zA-Z0-9_\\-]+\\.php)",
      "dest": "/api/index.php?__page=$1"
    },
    {
      "src": "/$",
      "dest": "/api/index.php?__page=index.php"
    }
  ]
}
